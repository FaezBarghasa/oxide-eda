format = "snxpcb/1"
pcb_id = "55dab71a-a894-4eb9-96ac-ea264e2e68e3"
version = 1
generator = "Oxide EDA"
thickness = 1.6


[stackup]
layers = [
    "F.Cu",
    "In1_AGND",
    "In2_Power",
    "B.Cu",
]

[[nets.entries]]
number = 1
name = "AGND_CLEAN"

[[nets.entries]]
number = 2
name = "DGND"

[[nets.entries]]
number = 3
name = "+15V_ANALOG"

[[nets.entries]]
number = 4
name = "-15V_ANALOG"

[[nets.entries]]
number = 5
name = "+3V3_DIGITAL"

[footprints]
content = """
uuid  ref  library  pos_x  pos_y  rotation  layer  value
"""

[pads]
content = """
uuid  footprint_ref  pin  pos_x  pos_y  size_x  size_y  pad_type  shape  layers  drill  net_number  net_name  roundrect_ratio
"""

[tracks]
content = """
uuid  net  layer  width  start_x  start_y  end_x  end_y
"""

[vias]
content = """
uuid  net  pos_x  pos_y  drill  diameter  layers  via_type
"""
